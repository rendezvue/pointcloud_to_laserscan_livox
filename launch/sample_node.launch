<?xml version="1.0"?>

<launch>
    
    <arg name="lidar_name" default="livox" />

    <!-- start sensor-->
    <!-- <include file="$(find openni2_launch)/launch/openni2.launch">
        <arg name="camera" default="$(arg camera)"/>
    </include> -->

    <!-- run pointcloud_to_laserscan node -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">

        <remap from="cloud_in" to="$(arg lidar_name)/lidar"/>
        <remap from="scan" to="$(arg lidar_name)/scan"/>
        <rosparam>
            target_frame: livox_frame # Leave disabled to output scan in pointcloud frame
            transform_tolerance: 0.01
            min_height: 0.0
            max_height: 1.0

            angle_min: -3.141592 # -M_PI
            angle_max: 3.141592 # M_PI
            angle_increment: 0.00872665 # M_PI/360.0 <!--레이저 스캔 한 스텝(step)당 각도 해상도(라디안).0.5도-->
            scan_time: 0.3333 <!--스캔 시간, 영향 안주는 경우 많다고함(회전라이다에서 사용되는듯)-->
            range_min: 0.30
            range_max: 2.0
            use_inf: true
            inf_epsilon: 1.0

            # Concurrency level, affects number of pointclouds queued for processing, thread number governed by nodelet manager
            # 0 : Detect number of cores
            # 1 : Single threaded
            # 2->inf : Parallelism level
            concurrency_level: 2
        </rosparam>

    </node>

</launch>
